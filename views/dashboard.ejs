<%- include('partials/header') %>

<div class="dashboard-head">
  <div>
    <h1>Your vault</h1>
    <p class="muted">Welcome back, <strong><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name : email %></strong></p>
  </div>
  <form method="post" action="/logout">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-outline btn-sm" type="submit">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign out
    </button>
  </form>
</div>

<% if (saved) { %>
  <div class="alert alert-success" role="status">Entry saved securely.</div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error" role="alert"><%= error %></div>
<% } %>

<section class="card" aria-labelledby="add-heading">
  <h2 id="add-heading">Add an entry</h2>
  <form method="post" action="/entries" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid three-columns">
      <div class="field">
        <label for="appName">Application / website</label>
        <input id="appName" name="appName" type="text" maxlength="100" required
               placeholder="e.g. example.com">
      </div>
      <div class="field">
        <label for="username">Username / email</label>
        <input id="username" name="username" type="text" maxlength="200" required
               autocomplete="off" placeholder="you@example.com">
      </div>
      <div class="field">
        <label for="entryPassword">Password</label>
        <div class="input-wrap">
          <input id="entryPassword" name="password" type="password" maxlength="200" required
                 autocomplete="new-password" placeholder="••••••••">
          <button type="button" class="eye-btn" aria-label="Show password" onclick="togglePwd(this)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>
    </div>
    <button class="btn btn-primary" type="submit">Save entry</button>
  </form>
</section>

<section class="card" aria-labelledby="entries-heading">
  <div class="section-head">
    <h2 id="entries-heading">Saved entries</h2>
    <span class="count" aria-label="<%= entries.length %> entries"><%= entries.length %></span>
  </div>

  <% if (entries.length === 0) { %>
    <p class="empty">No entries yet. Add your first one above.</p>
  <% } else { %>
    <ul class="entry-list">
      <% entries.forEach(function (entry) { %>
        <li class="entry">
          <div class="entry-row">
            <div class="entry-name">
              <span class="entry-icon" aria-hidden="true"><%= entry.app_name.charAt(0).toUpperCase() %></span>
              <span>
                <strong><%= entry.app_name %></strong>
                <small class="muted">Added <%= entry.created_at.slice(0, 10) %></small>
              </span>
            </div>
            <form method="post" action="/entries/<%= entry.id %>/reveal">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline" type="submit">Reveal</button>
            </form>
          </div>

          <% if (revealed && revealed.id === entry.id) { %>
            <div class="revealed" role="region" aria-label="Decrypted credentials for <%= entry.app_name %>">
              <dl>
                <div><dt>Username</dt><dd class="secret"><%= revealed.username %></dd></div>
                <div>
                  <dt>Password</dt>
                  <dd class="secret revealed-pwd-row">
                    <span class="revealed-pwd"><%= revealed.password %></span>
                    <button type="button" class="eye-btn eye-btn-inline" aria-label="Show password" onclick="toggleRevealedPwd(this)">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                  </dd>
                </div>
              </dl>
              <a class="btn btn-sm btn-ghost" href="/dashboard">Hide</a>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<script>
  const eyeOpen = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const eyeOff  = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
  const eyeOpen16 = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const eyeOff16  = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;

  function togglePwd(btn) {
    const input = btn.closest('.input-wrap').querySelector('input');
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.innerHTML = isHidden ? eyeOff : eyeOpen;
    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
  }

  function toggleRevealedPwd(btn) {
    const span = btn.closest('.revealed-pwd-row').querySelector('.revealed-pwd');
    const isHidden = span.dataset.masked !== 'true';
    if (isHidden) {
      span.dataset.originalText = span.textContent;
      span.textContent = '•'.repeat(span.textContent.length);
      span.dataset.masked = 'true';
      btn.innerHTML = eyeOff16;
      btn.setAttribute('aria-label', 'Show password');
    } else {
      span.textContent = span.dataset.originalText;
      span.dataset.masked = 'false';
      btn.innerHTML = eyeOpen16;
      btn.setAttribute('aria-label', 'Hide password');
    }
  }
</script>

<%- include('partials/footer') %>
