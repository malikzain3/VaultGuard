<%
  const activeMode = (typeof mode !== 'undefined' && (mode === 'signup' || mode === 'signin')) ? mode : 'signin';
  const safeEmail  = typeof email !== 'undefined' ? email : '';
  const safeName   = typeof name  !== 'undefined' ? name  : '';
%>
<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">

    <!-- Card heading changes with the active panel -->
    <div class="auth-heading">
      <h1 id="auth-title"><%= activeMode === 'signup' ? 'Create your vault' : 'Welcome back' %></h1>
      <p class="auth-subtitle"><%= activeMode === 'signup'
          ? 'Set up your encrypted vault in seconds.'
          : 'Sign in to access your encrypted vault.' %></p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <!-- Sign in panel -->
    <div
      id="panel-signin"
      role="region"
      aria-labelledby="auth-title"
      class="auth-panel<%= activeMode === 'signin' ? ' active' : '' %>"
    >
      <form method="post" action="/auth/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="signin-email">Email address</label>
          <input id="signin-email" name="email" type="email" inputmode="email"
                 autocomplete="username" maxlength="254" required
                 placeholder="you@example.com" value="<%= activeMode === 'signin' ? safeEmail : '' %>">
        </div>
        <div class="field">
          <label for="signin-password">Password</label>
          <div class="input-wrap">
            <input id="signin-password" name="password" type="password"
                   autocomplete="current-password" maxlength="128" required
                   placeholder="Your account password">
            <button type="button" class="eye-btn" aria-label="Show password"
                    onclick="togglePwd(this)">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button class="btn btn-primary btn-full" type="submit">Sign in</button>
      </form>
      <p class="auth-switch">
        Don't have an account?
        <button type="button" class="link-btn" onclick="switchTab('signup')">Create account</button>
      </p>
    </div>

    <!-- Create account panel -->
    <div
      id="panel-signup"
      role="region"
      aria-labelledby="auth-title"
      class="auth-panel<%= activeMode === 'signup' ? ' active' : '' %>"
    >
      <form method="post" action="/auth/signup" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="signup-name">Full name</label>
          <input id="signup-name" name="name" type="text"
                 autocomplete="name" maxlength="100" required
                 placeholder="Jane Smith" value="<%= activeMode === 'signup' ? safeName : '' %>">
        </div>
        <div class="field">
          <label for="signup-email">Email address</label>
          <input id="signup-email" name="email" type="email" inputmode="email"
                 autocomplete="username" maxlength="254" required
                 placeholder="you@example.com" value="<%= activeMode === 'signup' ? safeEmail : '' %>">
        </div>
        <div class="field">
          <label for="signup-password">Password</label>
          <div class="input-wrap">
            <input id="signup-password" name="password" type="password"
                   autocomplete="new-password" minlength="8" maxlength="128" required
                   placeholder="At least 8 characters">
            <button type="button" class="eye-btn" aria-label="Show password"
                    onclick="togglePwd(this)">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="hint">Used only to sign in. Your master password encrypts the vault.</p>
        </div>
        <button class="btn btn-primary btn-full" type="submit">Create account</button>
      </form>
      <p class="auth-switch">
        Already have an account?
        <button type="button" class="link-btn" onclick="switchTab('signin')">Sign in</button>
      </p>
    </div>

  </div>
</div>

<script>
  const eyeOpen = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const eyeOff  = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;

  function togglePwd(btn) {
    const input = btn.closest('.input-wrap').querySelector('input');
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.innerHTML = isHidden ? eyeOff : eyeOpen;
    btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
  }

  function switchTab(tab) {
    // Toggle panels
    document.querySelectorAll('.auth-panel').forEach(p => {
      p.classList.toggle('active', p.id === 'panel-' + tab);
    });

    // Update the card heading & subtitle
    const title    = document.getElementById('auth-title');
    const subtitle = document.querySelector('.auth-subtitle');
    if (tab === 'signup') {
      title.textContent    = 'Create your vault';
      subtitle.textContent = 'Set up your encrypted vault in seconds.';
    } else {
      title.textContent    = 'Welcome back';
      subtitle.textContent = 'Sign in to access your encrypted vault.';
    }

    // Update the single navbar button to show the opposite action
    const navBtn = document.querySelector('.btn-nav-secondary');
    if (navBtn) {
      if (tab === 'signup') {
        navBtn.textContent = 'Sign in';
        navBtn.href = '/auth?mode=signin';
      } else {
        navBtn.textContent = 'Create account';
        navBtn.href = '/auth?mode=signup';
      }
    }

    // Sync URL
    const url = new URL(window.location.href);
    url.searchParams.set('mode', tab);
    history.replaceState(null, '', url.toString());
  }
</script>

<%- include('partials/footer') %>
